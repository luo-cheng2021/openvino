 namespace KERNEL_NAME {

#include <cm/cm.h>

#define BUFFERINDEX(x) int * x [[type("svmptr_t")]]
#define LSC_LOAD(DATA_TYPE, VS, L1, L3) cm_ptr_load<DATA_TYPE,VS,DataSize::Default,CacheHint::L1,CacheHint::L3>
#define LSC_STORE(DATA_TYPE, VS, L1, L3) cm_ptr_store<DATA_TYPE,VS,DataSize::Default,CacheHint::L1,CacheHint::L3>
#define LSC_LOAD_0(DATA_TYPE, VS)  cm_ptr_load<DATA_TYPE,VS,DataSize::Default,CacheHint::Cached,CacheHint::Cached>

#define VS      2
#define GS      1
#define ES      32
typedef half    IT;

constexpr int QK = 128; // compatible
constexpr int SBS = 2; // compatible
constexpr int BLOCK_SIZE = QK / 2;
constexpr int SCALE_SIZE = sizeof(IT);
constexpr int NUM_EXPERTS = 8;


inline auto load_qblock(const uint8_t* weight, const uint8_t* scale, const uint8_t* zero_point, bool is_even) {
    vector<uint8_t, BLOCK_SIZE> ybytes;
    ybytes.format<int>() = LSC_LOAD_0(int, (BLOCK_SIZE / 4))((int*)weight, 0); //read 64 bytes
    IT scales = *(const IT*)scale;      // 1x scale   TODO pointer access
    uint8_t zero_points = *(const uint8_t*)zero_point;

    int8_t zp = ((is_even) ? (int8_t)(zero_points & (uint8_t)0xF) : (int8_t)(zero_points >> (uint8_t)4));
    vector<uint8_t, QK> uyv;
    // uyv.select<QK / 2, 1>(0) = ybytes & (uint8_t)0xF;
    // uyv.select<QK / 2, 1>(QK / 2) = ybytes >> (uint8_t)4;
    uyv.select<QK / 2, 2>(0) = ybytes & (uint8_t)0xF; // compatible
    uyv.select<QK / 2, 2>(1) = ybytes >> (uint8_t)4; // compatible
    vector<IT, QK> yv = (uyv.format<int8_t>() - (int8_t)zp) * scales;

    return yv;
}

inline auto load_qblocks(const uint8_t* weight, vector_ref<IT, SBS> scales, vector_ref<uint8_t, SBS> zero_points)
{
    vector<uint8_t, BLOCK_SIZE* SBS> ybytes;   //128bytes
    ybytes.format<int>() = LSC_LOAD_0(int, (BLOCK_SIZE * SBS / 4))((int*)weight, 0);

    vector<IT, QK* SBS> yvs;
#pragma unroll
    for (int i = 0; i < SBS; ++i) {
        vector<uint8_t, QK> uyv;
        uyv.select<QK / 2, 2>(0) = ybytes.template select<QK / 2, 1>(i * QK / 2) & (uint8_t)0xF; // compatible
        uyv.select<QK / 2, 2>(1) = ybytes.template select<QK / 2, 1>(i * QK / 2) >> (uint8_t)4; // compatible
        yvs.template select<QK, 1>(i * QK) = (uyv.format<int8_t>() - (int8_t)zero_points[i]) * scales[i];
    }
    return yvs;
}

constexpr short baseOffsetIncNbDown[6] = { 0, 1, 2, 3, 4, 5 };
_GENX_MAIN_ void KERNEL_NAME(
    BUFFERINDEX(input),
    BUFFERINDEX(indexs),
    BUFFERINDEX(eweights),
    BUFFERINDEX(weights_base), //includes all 128 addrs 
    BUFFERINDEX(weights_offset),
    BUFFERINDEX(output)
) {
    const int state_size = INTERMEDIATE_SIZE;
    const int output_size = HIDDEN_SIZE;

    const int nb = state_size / QK;
    const int nsb = nb / SBS;

    const int eid = cm_group_id(0) * cm_local_size(0) + cm_local_id(0);
    const int tid = cm_local_id(1);
    const int vid = cm_group_id(1) * VS;


    vector<int, NUM_EXPERTS> indexs_vec = LSC_LOAD_0(int, NUM_EXPERTS)(indexs, 0);
    int index = indexs_vec[eid];

    vector<IT, NUM_EXPERTS> eweights_vec;
    eweights_vec.format<int>() = LSC_LOAD_0(int, 4)(eweights, 0);   //8 fp16
    const IT eweight = eweights_vec[eid];

    vector<int, 16> address_offsets = LSC_LOAD_0(int, 16)(weights_offset, index * 64);     //64 bytes for 1 expert

    const uint8_t* weight_base = (uint8_t*)weights_base + address_offsets[6] + nb * BLOCK_SIZE * vid;
    const uint8_t* scales = (uint8_t*)weights_base + address_offsets[7];
    const uint8_t* zp = (uint8_t*)weights_base + address_offsets[8];

    int input_base_offset = eid * state_size * sizeof(IT);

    vector<uint, nb> offset_gather(baseOffsetIncNbDown);
    vector<IT, VS* nb> scales_vec_gather; //4x 6 elements
    vector<IT, VS* nb> scales_vec;
#if VS==4
    scales_vec_gather.format<int>() = cm_ptr_load<int, VectorSize::N2, DataSize::Default, CacheHint::Cached, CacheHint::Cached, nb>((int*)scales, (offset_gather * output_size + vid) * sizeof(IT));
    scales_vec.select<nb, 1>(0) = scales_vec_gather.select<nb, 2>(0);
    scales_vec.select<nb, 1>(nb) = scales_vec_gather.select<nb, 2>(1);
    scales_vec.select<nb, 1>(2 * nb) = scales_vec_gather.select<nb, 2>(0 + nb * VS / 2);
    scales_vec.select<nb, 1>(3 * nb) = scales_vec_gather.select<nb, 2>(1 + nb * VS / 2);
#endif
#if VS==2
    scales_vec_gather.format<int>() = cm_ptr_load<int, VectorSize::N1, DataSize::Default, CacheHint::Cached, CacheHint::Cached, nb>((int*)scales, (offset_gather * output_size + vid) * sizeof(IT));
    scales_vec.select<nb, 1>(0) = scales_vec_gather.select<nb, 2>(0);     //TODO VS==2
    scales_vec.select<nb, 1>(nb) = scales_vec_gather.select<nb, 2>(1);
#endif
    vector<uint8_t, VS* nb / 2> zps_vec_gather;  //4x 6 elements
    vector<uint8_t, VS* nb > zps_vec;
#if VS==4
    zps_vec_gather.format<uint16_t>() = cm_ptr_load<uint16_t, VectorSize::N1, DataSize::Default, CacheHint::Cached, CacheHint::Cached, nb>((uint16_t*)zp, (offset_gather * output_size + vid) / 2);
    zps_vec.select<nb, 1>(0) = zps_vec_gather.select<nb, 2>(0) & 0xF;
    zps_vec.select<nb, 1>(nb) = zps_vec_gather.select<nb, 2>(0) >> 4;
    zps_vec.select<nb, 1>(2 * nb) = zps_vec_gather.select<nb, 2>(1) & 0xF;
    zps_vec.select<nb, 1>(3 * nb) = zps_vec_gather.select<nb, 2>(1) >> 4;
#endif
#if VS==2
    zps_vec_gather.select<nb, 1>(0) = cm_ptr_load<uint8_t, VectorSize::N1, DataSize::Default, CacheHint::Cached, CacheHint::Cached, nb>(zp, (offset_gather * output_size + vid) / 2);
    zps_vec.select<nb, 1>(0) = zps_vec_gather.select<nb, 1>(0) & 0xF;
    zps_vec.select<nb, 1>(nb) = zps_vec_gather.select<nb, 1>(0) >> 4;
#endif
    vector<IT, VS* ES> accvs{};

    for (int s = tid; s < nsb; s += GS) {
        vector<IT, SBS* QK> xvs;      //512 bytes
        xvs.format<int>().select<64, 1>(0) = LSC_LOAD_0(int, 64)((int*)input, input_base_offset + s * SBS * QK * sizeof(IT));
        xvs.format<int>().select<64, 1>(64) = LSC_LOAD_0(int, 64)((int*)input, input_base_offset + s * SBS * QK * sizeof(IT) + 256);
        //if constexpr (SBS == 4) {
     //    xvs.format<int>().select<64, 1>(128) = LSC_LOAD_0(int, 64)((int*)input, s * SBS * QK * sizeof(IT) + 512);
     //    xvs.format<int>().select<64, 1>(192) = LSC_LOAD_0(int, 64)((int*)input, s * SBS * QK * sizeof(IT) + 768);
     //}
#pragma unroll
        for (int v = 0; v < VS; ++v) {
            vector<IT, SBS* QK> yvs = load_qblocks(
                weight_base + v * nb * BLOCK_SIZE + s * SBS * BLOCK_SIZE,
                scales_vec.select<SBS, 1>(v * nb + s * SBS), zps_vec.select<SBS, 1>(v * nb + s * SBS)
            );

#pragma unroll
            for (int i = 0; i < SBS * QK; i += ES) {
                accvs.select<ES, 1>(v * ES) += xvs.select<ES, 1>(i) * yvs.select<ES, 1>(i);
            }
        }
    }

    for (int b = nsb * SBS + tid; b < nb; b += GS) {
        vector<IT, QK> xv;   //256bytes
        xv.format<int>() = LSC_LOAD_0(int, (QK / 2))((int*)input, input_base_offset + b * QK * sizeof(IT));

#pragma unroll
        for (int v = 0; v < VS; ++v) {
            vector<IT, QK> yv = load_qblock(
                weight_base + v * nb * BLOCK_SIZE + b * BLOCK_SIZE,
                scales + SCALE_SIZE * vid + v * SCALE_SIZE + b * output_size * SCALE_SIZE,
                zp + vid / 2 + v / 2 + b * output_size / 2, (b % 2 == 0)
            );
#pragma unroll
            for (int i = 0; i < QK; i += ES) {
                accvs.select<ES, 1>(v * ES) += xv.select<ES, 1>(i) * yv.select<ES, 1>(i);
            }
        }
    }

    vector<float, VS> accs;
#pragma unroll
    for (int v = 0; v < VS; ++v) {
        accs[v] = cm_sum<float>(accvs.select<ES, 1>(v * ES));
    }

    vector<IT, VS> accs_fp16 = accs *eweight;
    LSC_STORE(int, VS / 2, WriteBack, WriteBack)((int*)output, (eid * output_size + vid) * sizeof(IT), accs_fp16.format<int>());//fp16
}

}